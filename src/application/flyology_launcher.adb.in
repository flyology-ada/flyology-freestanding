with Flyology.RTS;
with @APPLICATION_UNIT@;

procedure Flyology_Launcher is
begin
   if Flyology.RTS.Number_Of_CPUs = 0 then
      raise Program_Error;
   end if;
   @APPLICATION_UNIT@;
end Flyology_Launcher;
