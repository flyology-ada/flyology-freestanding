project Flyology_Proof is
   for Languages use ("Ada");
   for Source_Dirs use ("../runtime/core");
   for Excluded_Source_Files use
     ("flyology-task_core.ads", "flyology-task_core.adb");
   for Object_Dir use "../build/proof";

   package Compiler is
      for Default_Switches ("Ada") use
        ("-gnat2022", "-gnatwa", "-gnatwe", "-gnatVa");
   end Compiler;
end Flyology_Proof;
