project Flyology_Freestanding_Proof is
   for Languages use ("Ada");
   for Source_Dirs use ("../src/primitives");
   for Object_Dir use "../build/proof";

   package Compiler is
      for Default_Switches ("Ada") use
        ("-gnat2022", "-gnatwa", "-gnatwe", "-gnatVa");
   end Compiler;
end Flyology_Freestanding_Proof;
