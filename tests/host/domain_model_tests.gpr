project Domain_Model_Tests is
   for Languages use ("Ada");
   for Source_Dirs use (".", "../../src/primitives");
   for Object_Dir use "../../build/host-domain-model/obj";
   for Exec_Dir use "../../build/host-domain-model/bin";
   for Main use ("domain_model_tests.adb");

   package Compiler is
      for Default_Switches ("Ada") use
        ("-gnat2022", "-gnata", "-gnatwa", "-gnatwe", "-gnatVa");
   end Compiler;
end Domain_Model_Tests;
