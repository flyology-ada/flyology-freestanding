project M5_Policy_Tests is
   for Languages use ("Ada");
   for Source_Dirs use (".", "../../runtime/core");
   for Object_Dir use "../../build/host-m5-policy/obj";
   for Exec_Dir use "../../build/host-m5-policy/bin";
   for Main use ("m5_policy_tests.adb");

   package Compiler is
      for Default_Switches ("Ada") use
        ("-gnat2022", "-gnata", "-gnatwa", "-gnatwe", "-gnatVa");
   end Compiler;
end M5_Policy_Tests;
