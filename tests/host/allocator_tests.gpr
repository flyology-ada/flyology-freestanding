project Allocator_Tests is
   for Languages use ("Ada");
   for Source_Dirs use (".", "../../src/primitives");
   for Object_Dir use "../../build/host-allocator/obj";
   for Exec_Dir use "../../build/host-allocator/bin";
   for Main use ("allocator_tests.adb");

   package Compiler is
      for Default_Switches ("Ada") use
        ("-gnat2022", "-gnata", "-gnato", "-gnatwa", "-gnatwe");
   end Compiler;
end Allocator_Tests;
