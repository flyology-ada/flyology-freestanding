project Preemption_Policy_Tests is
   for Languages use ("Ada");
   for Source_Dirs use (".", "../../src/primitives");
   for Object_Dir use "../../build/host-preemption-policy/obj";
   for Exec_Dir use "../../build/host-preemption-policy/bin";
   for Main use ("preemption_policy_tests.adb");

   package Compiler is
      for Default_Switches ("Ada") use
        ("-gnat2022", "-gnata", "-gnatwa", "-gnatwe", "-gnatVa");
   end Compiler;
end Preemption_Policy_Tests;
