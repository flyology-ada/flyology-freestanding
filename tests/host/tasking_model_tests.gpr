project Tasking_Model_Tests is
   for Languages use ("Ada");
   for Source_Dirs use (".", "../../src/primitives");
   for Object_Dir use "../../build/host-model/obj";
   for Exec_Dir use "../../build/host-model/bin";
   for Main use ("tasking_model_tests.adb");

   package Compiler is
      for Default_Switches ("Ada") use
        ("-gnat2022", "-gnata", "-gnato", "-gnatwa", "-gnatwe");
   end Compiler;
end Tasking_Model_Tests;
