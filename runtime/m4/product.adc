--  Product task-root propagation remains deliberately contained while M4
--  grows the exact abnormal-completion contract. Controlled finalization is
--  enabled; exception and tag registration remain deliberately unavailable.
pragma Restrictions (No_Exception_Propagation);
pragma Restrictions (No_Exception_Registration);
pragma Restrictions (No_Tagged_Type_Registration);
