library project Flyology_Freestanding_Primitives is
   for Languages use ("Ada");
   for Source_Dirs use ("../src/primitives");
   for Object_Dir use "../build/alire/obj";
   for Library_Dir use "../build/alire/lib";
   for Library_Name use "flyology_freestanding_primitives";
   for Library_Kind use "static";

   package Compiler is
      for Default_Switches ("Ada") use
        ("-gnat2022", "-gnatwa", "-gnatwe", "-gnatVa", "-gnato");
   end Compiler;
end Flyology_Freestanding_Primitives;
